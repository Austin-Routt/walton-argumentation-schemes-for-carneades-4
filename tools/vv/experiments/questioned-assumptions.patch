+// IsQuestioned reports whether a statement has been called into question.
+func (ag *ArgGraph) IsQuestioned(stmt_id string) bool {
+	n := terms.Normalize(stmt_id)
+	for _, q := range ag.Questioned {
+		if terms.Normalize(q) == n {
+			return true
+		}
+	}
+	return false
+}
+
+// dropQuestioned removes the statements that have been called into question
+// from the assumptions of the graph.
+func (ag *ArgGraph) dropQuestioned() {
+	if len(ag.Questioned) == 0 {
+		return
+	}
+	keep := []string{}
+	for _, k := range ag.Assumptions {
+		if !ag.IsQuestioned(k) {
+			keep = append(keep, k)
+		}
+	}
+	ag.Assumptions = keep
+}
