+// inStore reports whether a ground constraint equal to g is alive in the store.
+// It looks only at the constraints that share g's functor and the kind (and,
+// for atoms and compounds, the name) of its first argument.
+func inStore(s store, g *Compound) bool {
+	aArg, ok := s[g.Functor]
+	if !ok || len(g.OccurVars()) > 0 {
+		return false
+	}
+	var bucket CList
+	if len(g.Args) == 0 {
+		bucket = aArg.noArg
+	} else {
+		switch a := g.Args[0].(type) {
+		case Atom:
+			bucket = aArg.atomArg[string(a)]
+		case Bool:
+			bucket = aArg.boolArg
+		case Int:
+			bucket = aArg.intArg
+		case Float:
+			bucket = aArg.floatArg
+		case String:
+			bucket = aArg.strArg
+		case Compound:
+			bucket = aArg.compArg[a.Functor]
+		case List:
+			bucket = aArg.listArg
+		default:
+			bucket = aArg.varArg
+		}
+	}
+	for _, c := range bucket {
+		if c != nil && !c.IsDeleted && len(c.Args) == len(g.Args) && Equal(*c, *g) {
+			return true
+		}
+	}
+	return false
+}
